{
  "manifest_version": 2,
  "name": "Mini Player - YouTube Music",
  "version": "2.0.0",
  "description": "Mini Player responsivo e elegante para controlar o YouTube Music em qualquer aba.",
  "browser_specific_settings": {
    "gecko": {
      "id": "minimal-tab-miniplayer@local.extension",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*",
        "*://www.youtube.com/*"
      ],
      "js": ["ytm-controller.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Mini Player",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}

